# Access rules for the mdb database. Load with:
#   docker exec kandang-ldap ldapmodify -Y EXTERNAL -H ldapi:/// -f /ldif/acl.ldif   (laptop)
#   sudo ldapmodify -Y EXTERNAL -H ldapi:/// -f acl.ldif                            (VPS)
# cn=admin keeps full access as rootDN; these rules add the auth-service account and protect passwords
# "anonymous auth" only lets a bind compare the password; it never allows reading anything
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword
  by self write
  by dn.exact="cn=auth-service,ou=services,dc=kandang,dc=local" write
  by anonymous auth
  by * none
olcAccess: {1}to dn.subtree="ou=people,dc=kandang,dc=local"
  by dn.exact="cn=auth-service,ou=services,dc=kandang,dc=local" write
  by self read
  by anonymous auth
  by * none
olcAccess: {2}to dn.subtree="ou=groups,dc=kandang,dc=local"
  by dn.exact="cn=auth-service,ou=services,dc=kandang,dc=local" write
  by * none
olcAccess: {3}to *
  by self read
  by anonymous auth
  by * none
