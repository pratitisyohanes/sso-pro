# Directory tree, service account and demo users for dc=kandang,dc=local
# uid values equal the fixed ids in fin-pro/backend/src/database/seeders/20261011000001-demo-data.js
# Demo passwords: service-secret · Admin12345 · User12345 (hashes made with: npm run ldap:hash -- "<password>")
# Production: replace every userPassword with a new hash and use the UUIDs from booking_db on the VPS

dn: ou=people,dc=kandang,dc=local
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=kandang,dc=local
objectClass: organizationalUnit
ou: groups

dn: ou=services,dc=kandang,dc=local
objectClass: organizationalUnit
ou: services

dn: cn=auth-service,ou=services,dc=kandang,dc=local
objectClass: simpleSecurityObject
objectClass: organizationalRole
cn: auth-service
description: Service account used by sso-pro auth-service
userPassword: {SSHA}hjmnn5NtEE0DJHmKh8HQsY66+nM0cG5MBSaCUw==

