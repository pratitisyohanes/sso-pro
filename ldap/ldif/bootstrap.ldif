# groupOfNames needs at least one member, so the empty group holds the service account
dn: cn=disabled,ou=groups,dc=kandang,dc=local
objectClass: groupOfNames
cn: disabled
description: Members cannot log in to any application
member: cn=auth-service,ou=services,dc=kandang,dc=local
