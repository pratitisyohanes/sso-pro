<%- include('partials/top', { title: 'Change password' }) %>
    <h1>Change password</h1>
    <p class="sub">Your other devices will be logged out after the change.</p>

    <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert ok" role="status"><%= notice %></div><% } %>

    <form method="post" action="/account/password" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="currentPassword">Current password
        <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required autofocus aria-invalid="<%= errors.currentPassword ? 'true' : 'false' %>">
        <% if (errors.currentPassword) { %><span class="field-error"><%= errors.currentPassword %></span><% } %>
      </label>
      <label for="password">New password
        <input id="password" name="password" type="password" autocomplete="new-password" required aria-invalid="<%= errors.password ? 'true' : 'false' %>">
        <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } else { %><span class="hint">At least 8 characters with a letter and a number</span><% } %>
      </label>
      <label for="confirmPassword">Repeat new password
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required aria-invalid="<%= errors.confirmPassword ? 'true' : 'false' %>">
        <% if (errors.confirmPassword) { %><span class="field-error"><%= errors.confirmPassword %></span><% } %>
      </label>
      <button type="submit">Change password</button>
    </form>

    <p class="foot"><a href="/">Back to ELEFEZ FARM home</a></p>
<%- include('partials/bottom') %>
