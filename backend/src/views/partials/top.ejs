<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title><%= title %> · ELEFEZ FARM</title>
<link rel="icon" type="image/png" href="/favicon.png">
<style>
/* KandangID pages: one centred card; violet is the KandangID colour used in every project doc */
:root {
  --bg: #f4f3f8; --card: #ffffff; --fg: #1d1b26; --muted: #625e70; --line: #dddae6;
  --accent: #5b3fa6; --accent-fg: #ffffff; --accent-soft: #eee9f8;
  --err: #b3352b; --err-soft: #fbe6e3; --ok: #1d7a43; --ok-soft: #e3f4ea;
  --field: #fbfaff;
  font-family: "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #131219; --card: #1c1a24; --fg: #ebe9f2; --muted: #a6a1b5; --line: #312d3d;
    --accent: #a993ec; --accent-fg: #17131f; --accent-soft: #2a2340; --err: #f08a80; --err-soft: #3d1f1c;
    --ok: #6ccf93; --ok-soft: #173323; --field: #17151e; color-scheme: dark; }
}
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--fg); display: grid; place-items: center; padding: 32px 16px; line-height: 1.5; }
main { width: 100%; max-width: 420px; display: grid; gap: 16px; }
.brand { display: flex; align-items: center; gap: 10px; justify-content: center; font-weight: 700; font-size: 18px; letter-spacing: .01em; }
.brand .mark { width: 44px; height: 44px; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 28px 24px; display: grid; gap: 18px; box-shadow: 0 1px 2px rgba(20, 16, 40, .04); }
h1 { font-size: 22px; margin: 0; line-height: 1.25; }
.sub { margin: -10px 0 0; color: var(--muted); font-size: 14px; }
form { display: grid; gap: 14px; }
label { display: grid; gap: 6px; font-size: 14px; font-weight: 600; }
input { font: inherit; font-weight: 400; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--field); color: var(--fg); width: 100%; }
input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
input[aria-invalid="true"] { border-color: var(--err); }
h2 { font-size: 16px; margin: 0; line-height: 1.3; }
.section { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line); }
.pw { position: relative; display: block; }
.pw input { padding-right: 68px; }
.pw-toggle { position: absolute; top: 50%; right: 6px; transform: translateY(-50%); display: inline-block; padding: 5px 10px; font-size: 13px; background: transparent; color: var(--accent); }
.pw-toggle:hover { background: var(--accent-soft); filter: none; }
.field-error { color: var(--err); font-size: 12.5px; font-weight: 400; }
.hint { color: var(--muted); font-size: 12.5px; font-weight: 400; }
button, .button { font: inherit; font-weight: 600; border: 0; border-radius: 8px; padding: 11px 14px; background: var(--accent); color: var(--accent-fg); cursor: pointer; text-align: center; text-decoration: none; display: block; }
button:hover, .button:hover { filter: brightness(1.08); }
button:focus-visible, .button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.button.secondary { background: transparent; color: var(--accent); border: 1px solid var(--line); }
.alert { border-radius: 8px; padding: 10px 12px; font-size: 14px; background: var(--err-soft); color: var(--err); }
.alert.ok { background: var(--ok-soft); color: var(--ok); }
.foot { text-align: center; font-size: 14px; color: var(--muted); margin: 0; }
a { color: var(--accent); }
.qr { display: grid; justify-items: center; gap: 8px; padding: 14px; border: 1px dashed var(--line); border-radius: 10px; }
.qr img { width: 176px; height: 176px; background: #fff; border-radius: 6px; padding: 6px; }
.secret { font-family: Consolas, "Courier New", monospace; font-size: 13px; background: var(--accent-soft); padding: 4px 8px; border-radius: 6px; word-break: break-all; text-align: center; }
ol.steps { margin: 0; padding-left: 20px; display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
.code-input { font-family: Consolas, "Courier New", monospace; font-size: 22px; letter-spacing: .4em; text-align: center; }
.who { display: grid; gap: 2px; }
.who strong { font-size: 17px; }
.badge { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .05em; padding: 2px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
.apps { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.apps a { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; color: var(--fg); }
.apps a span { color: var(--muted); font-size: 13px; }
.legal { text-align: center; font-size: 12px; color: var(--muted); margin: 0; }
</style>
</head>
<body>
<main>
  <div class="brand"><img class="mark" src="/logo.webp" alt=""><span>ELEFEZ FARM</span></div>
  <div class="card">
