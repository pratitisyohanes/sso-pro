<%- include('partials/top', { title: 'Create account' }) %>
    <h1>Create your account</h1>
    <p class="sub"><% if (appName) { %>then continue to <strong><%= appName %></strong><% } else { %>One account for Booking and POS<% } %></p>

    <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>

    <form method="post" action="/register" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="return_to" value="<%= returnTo %>">
      <label for="name">Full name
        <input id="name" name="name" autocomplete="name" value="<%= values.name || '' %>" required autofocus aria-invalid="<%= errors.name ? 'true' : 'false' %>">
        <% if (errors.name) { %><span class="field-error"><%= errors.name %></span><% } %>
      </label>
      <label for="email">Email
        <input id="email" name="email" type="email" autocomplete="email" value="<%= values.email || '' %>" required aria-invalid="<%= errors.email ? 'true' : 'false' %>">
        <% if (errors.email) { %><span class="field-error"><%= errors.email %></span><% } %>
      </label>
      <label for="phone">Phone <span class="hint">optional</span>
        <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="081234567890, or leave empty" value="<%= values.phone || '' %>" aria-invalid="<%= errors.phone ? 'true' : 'false' %>">
        <% if (errors.phone) { %><span class="field-error"><%= errors.phone %></span><% } %>
      </label>
      <label for="password">Password
        <input id="password" name="password" type="password" autocomplete="new-password" required aria-invalid="<%= errors.password ? 'true' : 'false' %>">
        <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } else { %><span class="hint">At least 8 characters with a letter and a number</span><% } %>
      </label>
      <label for="confirmPassword">Repeat password
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required aria-invalid="<%= errors.confirmPassword ? 'true' : 'false' %>">
        <% if (errors.confirmPassword) { %><span class="field-error"><%= errors.confirmPassword %></span><% } %>
      </label>
      <button type="submit">Create account</button>
    </form>

    <p class="foot">Already have an account? <a href="/login<%= returnTo !== '/' ? '?return_to=' + encodeURIComponent(returnTo) : '' %>">Log in</a></p>
<%- include('partials/bottom') %>
