# ==============================================================
# Application
# ==============================================================
# development | test | production
NODE_ENV=development
# auth-service only listens on localhost; booking-api calls it from the same machine
HOST=127.0.0.1
PORT=5002

# ==============================================================
# Database (PostgreSQL) - clients and audit log only, no user accounts
# ==============================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sso_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false

# # DB production (VPS)
# DB_USERNAME=sso_user
# DB_PASSWORD=change-me

# ==============================================================
# LDAP directory (OpenLDAP)
# ==============================================================
# Laptop: ../ldap/docker-compose.yml · VPS: slapd bound to 127.0.0.1
LDAP_URL=ldap://127.0.0.1:389
LDAP_BASE_DN=dc=kandang,dc=local
# Service account from ldap/ldif/bootstrap.ldif; may search and write ou=people and ou=groups
LDAP_BIND_DN=cn=auth-service,ou=services,dc=kandang,dc=local
LDAP_BIND_PASSWORD=service-secret
LDAP_TIMEOUT_MS=5000

# ==============================================================
# Service tokens (RS256)
# ==============================================================
# Create with: npm run keys:generate (never commit the key)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_KEY_ID=kid-2026-10
TOKEN_ISSUER=kandangid
SERVICE_TOKEN_EXPIRES=15m

# ==============================================================
# Single sign-on (OIDC) for the Booking and POS web apps
# ==============================================================
# Address browsers use for KandangID; also "iss" of user tokens (= SSO_ISSUER in booking-api and pos-api)
PUBLIC_URL=http://localhost:5002
# PUBLIC_URL=https://sso.pratitis.net
# APIs that accept user access tokens
USER_AUDIENCE=booking-api,pos-api
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_DAYS=7
# Idle limit of a KandangID login; every token refresh moves it forward
SESSION_HOURS=8
# true behind HTTPS (production); false on http://localhost
COOKIE_SECURE=false

# ==============================================================
# Two-factor authentication on the KandangID login page
# ==============================================================
MFA_ENFORCE_ADMIN=false
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MFA_ENCRYPTION_KEY=
MFA_ISSUER=ELEFEZ FARM

# ==============================================================
# Password reset by email ("Forgot password?" on the login page)
# ==============================================================
# Leave SMTP_HOST empty to work without email: "Forgot your password?" then tells people to ask the administrator,
# who creates a one-time link on the VPS with: npm run user:reset-link -- someone@example.com
# SUPPORT_CONTACT="WhatsApp 0812-3456-7890"
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true               # true for port 465, false for port 587 (STARTTLS)
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=the-16-letter-app-password
# MAIL_FROM="ELEFEZ FARM" <your-address@gmail.com>
